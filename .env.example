SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/doorstep?createDatabaseIfNotExist=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=app
SPRING_DATASOURCE_PASSWORD=app

# Host runs only. Compose sets REDIS_HOST=redis on the app container.
REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_ENABLED=true

# IntelliJ: Run -> Edit Configurations -> Active profiles: local (optional)
